# Normalize text to LF in the repo and working tree, including files edited from Windows tools.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artefacts
*.bit binary
*.bin binary
*.dcp binary
*.png binary
*.jpg binary
*.pdf binary
