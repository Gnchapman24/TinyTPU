# cmd_engine formal checks (task A4.1): reply framing and CRC, no reply without a completed
# request, the inter-byte timeout, host memory access only while stopped, no byte dropped
# while the receive queue has space, and progress. Any byte stream, abstract core.
# See cmd_engine_formal.sv. crc16_ccitt is replaced by formal/crc16_stub.sv (same timing, a
# checksum the solver can satisfy or break at will); the real CRC is checked in tb/test_crc16.py.

[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 30
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 40

[engines]
bmc: abc bmc3
prove: smtbmc
cover: smtbmc

[script]
plugin -i slang
bmc: read_slang -DFORMAL -DASSERTIONS -DPROP_BMC isa_pkg.sv sync_fifo.sv crc16_stub.sv cmd_engine.sv cmd_engine_formal.sv --top cmd_engine_formal
prove: read_slang -DFORMAL -DASSERTIONS isa_pkg.sv sync_fifo.sv crc16_stub.sv cmd_engine.sv cmd_engine_formal.sv --top cmd_engine_formal
cover: read_slang -DFORMAL -DASSERTIONS isa_pkg.sv sync_fifo.sv crc16_stub.sv cmd_engine.sv cmd_engine_formal.sv --top cmd_engine_formal
prep -top cmd_engine_formal
memory_map
opt -fast
# Variable part-selects ($shiftx) become x bits outside their range once techmapped, which the
# AIG flow (abc) rejects: techmap here, then make every remaining x a free value.
techmap
opt -fast
setundef -anyseq

[files]
../rtl/isa_pkg.sv
../rtl/sync_fifo.sv
crc16_stub.sv
../rtl/cmd_engine.sv
cmd_engine_formal.sv
