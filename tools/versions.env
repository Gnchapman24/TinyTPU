# Pinned tool versions for TinyTPU. Shell- and Make-compatible KEY=VALUE lines.
# Change a pin only deliberately, in its own commit, after re-running the test tiers.

# OSS CAD Suite (WSL): Yosys, yosys-slang, SymbiYosys, Verilator, solvers.
# The release is the suite's VERSION file (YYYYMMDD). CI downloads the same release.
OSS_CAD_SUITE_RELEASE=20261112
# Informational: versions bundled in that release (checked 2026-11-13).
OSS_CAD_SUITE_YOSYS=0.70+385
OSS_CAD_SUITE_SBY=0.70-9
OSS_CAD_SUITE_VERILATOR=5.055

# Vivado (Windows), at C:\AMDDesignTools\2025.2\Vivado
VIVADO_VERSION=2025.2

# Python (both sides), installed per project with uv. Package versions are locked in uv.lock.
PYTHON_VERSION=3.12
# uv: minimum version, enforced by [tool.uv] required-version in pyproject.toml
UV_MIN_VERSION=0.13.8
